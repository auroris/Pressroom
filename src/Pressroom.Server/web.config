<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <location path="." inheritInChildApplications="false">
    <system.webServer>
      <handlers>
        <add name="aspNetCore" path="*" verb="*" modules="AspNetCoreModuleV2" resourceType="Unspecified" />
      </handlers>
      <!-- The Web SDK rewrites processPath/arguments for the selected publish profile. -->
      <aspNetCore processPath="dotnet" arguments="" hostingModel="inprocess"
                  stdoutLogEnabled="false" startupTimeLimit="120" shutdownTimeLimit="60" />
      <security>
        <requestFiltering>
          <requestLimits maxAllowedContentLength="33554432" />
        </requestFiltering>
      </security>
      <httpErrors existingResponse="PassThrough" />
    </system.webServer>
  </location>
</configuration>
