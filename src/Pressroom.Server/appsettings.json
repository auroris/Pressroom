{
  "AllowedHosts": "*",
  "Render": {
    "Concurrency": 2,
    "QueueLimit": 8,
    "MaxBodyBytes": 26214400,
    "DefaultTimeoutMs": 30000,
    "MaxTimeoutMs": 60000,
    "ShutdownTimeoutMs": 30000,
    "RestartAfterRenders": 500,
    "DefaultPageSize": "Letter",
    "BrowsersPath": "browsers",
    "ChromiumSandbox": true
  },
  "Paths": {
    "StateRoot": "%ProgramData%\\Pressroom"
  },
  "Fonts": {
    "Manifest": "fonts/manifest.json"
  },
  "Auth": {
    "WindowsEnabled": true,
    "ApiKeys": {},
    "RequireGroup": false,
    "AccessGroup": null
  }
}
